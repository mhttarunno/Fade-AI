# Copy this file to `.env` and adjust values as needed.
# app.py loads these via python-dotenv when present.

# Flask
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=replace-with-a-long-random-string
PORT=5000

# Uploads
MAX_UPLOAD_MB=15
MAX_IMAGE_DIMENSION=2048

# Inpainting backend: "lama" (recommended, fast) or "sdxl" (slower, higher VRAM)
INPAINT_BACKEND=lama
SDXL_MODEL_ID=diffusers/stable-diffusion-xl-1.0-inpainting-0.1
SDXL_STEPS=30
SDXL_GUIDANCE_SCALE=7.5

# Device: "auto" | "cuda" | "cpu"
DEVICE=auto

# Mask post-processing
MASK_DILATE_PX=6

# File retention (minutes) before uploads/results are auto-cleaned
FILE_RETENTION_MINUTES=60
